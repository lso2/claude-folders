{
  "manifest_version": 3,
  "name": "Claude Folders",
  "version": "1.6.1",
  "description": "Organize your Claude conversations into folders",
  "permissions": [
    "storage",
    "tabs",
    "offscreen",
    "nativeMessaging",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "lib/chat-markdown.js",
        "lib/cowork-api.js",
        "lib/cowork-markdown.js",
        "lib/cowork-export.js",
        "lib/chat-exporter.js",
        "lib/share-snapshots.js",
        "lib/storage-keys.js",
        "lib/color-variants.js",
        "lib/select-size.js",
        "lib/button-color.js",
        "lib/update-notice.js",
        "lib/account-view.js",
        "lib/account-view-store.js",
        "lib/export-state.js",
        "lib/folder-picker.js",
        "lib/organize-prompt.js",
        "lib/organize-apply.js",
        "lib/organize-json.js",
        "lib/shell-address.js",
        "content/cf-state.js",
        "content/cf-text.js",
        "content/cf-tooltip.js",
        "content/cf-routes.js",
        "content/cf-account.js",
        "content/cf-notify.js",
        "content/cf-data.js",
        "content/cf-account-info.js",
        "content/cf-pending.js",
        "content/cf-styles.js",
        "content/cf-account-view.js",
        "content/cf-sidebar.js",
        "content/cf-row-hover.js",
        "content/cf-panel.js",
        "content/cf-folder-pane.js",
        "content/cf-chat.js",
        "content/cf-picker.js",
        "content/cf-url-watch.js",
        "content/cf-export-records.js",
        "content/cf-disk.js",
        "content/cf-reveal.js",
        "content/cf-export.js",
        "content/cf-export-state.js",
        "content/cf-run-state.js",
        "content/cf-export-run.js",
        "content/cf-export-messages.js",
        "content/cf-organize.js",
        "content/cf-organize-modal.js",
        "content/cf-organize-auto.js",
        "content/cf-panel-analytics.js",
        "content/cf-cowork-sync.js",
        "content/cf-sync.js",
        "content/cf-sync-control.js",
        "lib/run-failures.js",
        "content/cf-sync-summary.js",
        "content/cf-monitor.js",
        "content/cf-composer.js",
        "content/cf-shell-capture.js",
        "content/cf-shell-address.js",
        "content/cf-shell-replay.js",
        "content/cf-import-registry.js",
        "content/cf-import.js",
        "content/cf-import-record.js",
        "content/cf-import-controls.js",
        "content/cf-cowork-import.js",
        "content/cf-migrate-source.js",
        "content/cf-migrate.js",
        "content/cf-import-dialog.js",
        "content/cf-migrate-button.js",
        "content/cf-project-import.js",
        "content/cf-build-check.js",
        "content/cf-tab-request.js",
        "content/cf-core.js",
        "content/cf-boot.js"
      ],
      "css": [
        "lib/color-variants.css",
        "lib/select-picker.css",
        "inject.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "organizer/*",
        "lib/*",
        "standalone/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "update/index.html"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}
